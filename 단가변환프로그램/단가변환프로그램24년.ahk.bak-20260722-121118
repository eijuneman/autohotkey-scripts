LoadIniRows()
{
    global INI_FILE

    GuiControl, , IniPathText, %INI_FILE%
    Gui, ListView, IniLV
    LV_Delete()
    EnsureIniFile()

    if !FileExist(INI_FILE) {
        SB_SetText("INI 파일 없음: " INI_FILE)
        return
    }

    rowCount := 0
    Loop, Read, %INI_FILE%
    {
        line := A_LoopReadLine
        trimmed := Trim(line)

        if (trimmed = "")
            continue

        if (A_Index = 1 && IsCsvHeader(trimmed))
            continue

        cols := ParseCsvLine(line)
        if (cols.MaxIndex() >= 3) {
            section := cols[1]
            key := cols[2]
            value := cols[3]
            LV_Add("", section, key, value)
            rowCount++
        }
    }

    LV_ModifyCol(1, 140)
    LV_ModifyCol(2, 160)
    LV_ModifyCol(3, 295)
    SB_SetText("CSV " rowCount "개 항목 로드됨")
}

