SetSelectedProductFromDisplay(display)
{
    global ProductRows, SelectedProductName

    if (ProductRows.HasKey(display)) {
        row := ProductRows[display]
        SetSelectedProduct(row["code"], row["name"], row["spec"], row["mid"], row["sub"])
        return
    }

    SelectedProductName := GetSelectedProductName()
}

SetSelectedProduct(code, name, spec := "", mid := "", sub := "")
{
    global SelectedProductCode, SelectedProductName, SelectedProductSpec, SelectedProductMid, SelectedProductSub

    SelectedProductCode := code
    SelectedProductName := name
    SelectedProductSpec := spec
    SelectedProductMid := mid
    SelectedProductSub := sub
}

GetSelectedProductSection()
{
    global SelectedProductCode, SelectedProductName

    if (SelectedProductCode != "")
        return "상품_" SelectedProductCode

    if (SelectedProductName != "")
        return "상품명_" CleanIniSectionName(SelectedProductName)

    return ""
}

CleanIniSectionName(value)
{
    value := StrReplace(value, "[", "(")
    value := StrReplace(value, "]", ")")
    value := StrReplace(value, "`r", " ")
    value := StrReplace(value, "`n", " ")
    return Trim(value)
}

SaveSelectedProductPrice(showMessage := true)
{
    global PRODUCT_PRICE_INI, INI_FILE, SelectedProductCode, SelectedProductName, SelectedProductSpec, SelectedProductMid, SelectedProductSub
    global C, 소매, B, 매출, A, 중분류, 소분류y값

    Gui, Submit, NoHide
    section := GetSelectedProductSection()
    if (section = "") {
        if (showMessage)
            MsgBox, 48, 상품별 단가, 상품을 먼저 선택해주세요.
        return false
    }

    EnsureFile(PRODUCT_PRICE_INI)
    IniWrite, %SelectedProductCode%, %PRODUCT_PRICE_INI%, %section%, 상품코드
    IniWrite, %SelectedProductName%, %PRODUCT_PRICE_INI%, %section%, 상품명
    IniWrite, %SelectedProductSpec%, %PRODUCT_PRICE_INI%, %section%, 규격
    IniWrite, %SelectedProductMid%, %PRODUCT_PRICE_INI%, %section%, 중분류명
    IniWrite, %SelectedProductSub%, %PRODUCT_PRICE_INI%, %section%, 소분류명
    IniWrite, %중분류%, %PRODUCT_PRICE_INI%, %section%, 중분류
    IniWrite, %소분류y값%, %PRODUCT_PRICE_INI%, %section%, 소분류y값
    IniWrite, %C%, %PRODUCT_PRICE_INI%, %section%, C
    IniWrite, %소매%, %PRODUCT_PRICE_INI%, %section%, 소매
    IniWrite, %B%, %PRODUCT_PRICE_INI%, %section%, B
    IniWrite, %매출%, %PRODUCT_PRICE_INI%, %section%, 매출
    IniWrite, %A%, %PRODUCT_PRICE_INI%, %section%, A

    if (INI_FILE = PRODUCT_PRICE_INI)
        LoadIniRows()

    SB_SetText("상품별 단가 저장: " SelectedProductName)
    if (showMessage)
        MsgBox, 64, 상품별 단가, 상품별 단가를 저장했습니다.

    return true
}

LoadSelectedProductPrice(showMessage := true)
{
    global PRODUCT_PRICE_INI, SelectedProductName

    section := GetSelectedProductSection()
    if (section = "" || !FileExist(PRODUCT_PRICE_INI))
        return false

    IniRead, priceC, %PRODUCT_PRICE_INI%, %section%, C, ERROR
    if (priceC = "ERROR")
        return false

    IniRead, priceRetail, %PRODUCT_PRICE_INI%, %section%, 소매,
    IniRead, priceB, %PRODUCT_PRICE_INI%, %section%, B,
    IniRead, priceSales, %PRODUCT_PRICE_INI%, %section%, 매출,
    IniRead, priceA, %PRODUCT_PRICE_INI%, %section%, A,
    IniRead, categoryIndex, %PRODUCT_PRICE_INI%, %section%, 중분류,
    IniRead, rowY, %PRODUCT_PRICE_INI%, %section%, 소분류y값,

    if (categoryIndex != "")
        GuiControl, , 중분류, %categoryIndex%
    if (rowY != "")
        GuiControl, , 소분류y값, %rowY%
    GuiControl, , C, %priceC%
    GuiControl, , 소매, %priceRetail%
    GuiControl, , B, %priceB%
    GuiControl, , 매출, %priceSales%
    GuiControl, , A, %priceA%

    SB_SetText("상품별 단가 불러옴: " SelectedProductName)
    return true
}

GetSelectedProductName()
{
    global ProductSelect, ProductSearch, ProductDisplayToName, SelectedProductName

    if (SelectedProductName != "")
        return SelectedProductName

    if (ProductSelect != "" && ProductDisplayToName.HasKey(ProductSelect))
        return ProductDisplayToName[ProductSelect]

    if (ProductSelect != "")
        return ProductSelect

    return ProductSearch
}

LoadProductsFromMysql(searchText := "")
{
    global ProductRows, ProductDisplayToName, SelectedProductCode, SelectedProductName, SelectedProductSpec, SelectedProductMid, SelectedProductSub

    ProductRows := Object()
    ProductDisplayToName := Object()
    SelectedProductCode := ""
    SelectedProductName := ""
    SelectedProductSpec := ""
    SelectedProductMid := ""
    SelectedProductSub := ""
    cleanSearch := Trim(searchText)
    helper := A_ScriptDir "\product-search.js"
    outFile := A_Temp "\jedaero-product-search.tsv"

    if !FileExist(helper) {
        MsgBox, 16, 상품조회 실패, %helper% 파일이 없습니다.
        return
    }

    FileDelete, %outFile%
    command := "node """ helper """ """ cleanSearch """ """ outFile """"
    RunWait, %command%, C:\Users\shwoodnew\tms_new, Hide UseErrorLevel

    if (ErrorLevel != 0) {
        MsgBox, 16, MySQL 상품조회 실패, Node 상품조회 실행에 실패했습니다.`nErrorLevel: %ErrorLevel%
        return
    }

    if !FileExist(outFile) {
        MsgBox, 16, MySQL 상품조회 실패, 조회 결과 파일을 만들지 못했습니다.
        return
    }

    FileRead, productText, *P65001 %outFile%
    productList := ""
    rowCount := 0
    firstDisplay := ""
    firstCode := ""
    firstName := ""
    firstSpec := ""
    firstMid := ""
    firstSub := ""

    Gui, ListView, ProductLV
    LV_Delete()

    Loop, Parse, productText, `n, `r
    {
        if (A_LoopField = "")
            continue

        cols := StrSplit(A_LoopField, "`t")
        code := cols[1]
        name := cols[2]
        spec := cols[3]
        mid := cols[4]
        sub := cols[5]

        rowCount++
        display := CleanComboText(name " / " spec " / " mid "-" sub " [" code "]")
        ProductRows[display] := Object("code", code, "name", name, "spec", spec, "mid", mid, "sub", sub)
        ProductDisplayToName[display] := name
        productList .= display "|"
        LV_Add("", code, name, spec, mid, sub)
        if (rowCount = 1) {
            firstDisplay := display
            firstCode := code
            firstName := name
            firstSpec := spec
            firstMid := mid
            firstSub := sub
        }
    }

    LV_ModifyCol(1, 80)
    LV_ModifyCol(2, 220)
    LV_ModifyCol(3, 135)
    LV_ModifyCol(4, 95)
    LV_ModifyCol(5, 90)

    GuiControl, , ProductSelect, |%productList%
    if (rowCount > 0) {
        GuiControl, Choose, ProductSelect, 1
        LV_Modify(1, "Select Focus Vis")
        SetSelectedProduct(firstCode, firstName, firstSpec, firstMid, firstSub)
        GuiControl, , ProductSelect, %firstDisplay%
        LoadSelectedProductPrice(false)
        SB_SetText("상품 " rowCount "개 조회됨")
    } else {
        SB_SetText("조회된 상품이 없습니다")
    }
}

CleanComboText(value)
{
    value := StrReplace(value, "|", " ")
