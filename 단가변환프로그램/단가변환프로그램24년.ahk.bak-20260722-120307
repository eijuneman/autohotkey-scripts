LoadIniRows()
{
    global INI_FILE

    GuiControl, , IniPathText, %INI_FILE%
    Gui, ListView, IniLV
    LV_Delete()
    EnsureIniFile()

    if !FileExist(INI_FILE) {
        SB_SetText("INI 파일 없음: " INI_FILE)
        return
    }

    currentSection := ""
    rowCount := 0
    Loop, Read, %INI_FILE%
    {
        line := A_LoopReadLine
        trimmed := Trim(line)

        if (trimmed = "")
            continue

        firstChar := SubStr(trimmed, 1, 1)
        if (firstChar = ";" || firstChar = "#")
            continue

        if RegExMatch(trimmed, "^\[(.*)\]$", sectionMatch) {
            currentSection := sectionMatch1
            continue
        }

        if (currentSection != "" && RegExMatch(line, "^\s*([^=]+?)\s*=(.*)$", keyMatch)) {
            key := Trim(keyMatch1)
            value := Trim(keyMatch2)
            LV_Add("", currentSection, key, value)
            rowCount++
        }
    }

    LV_ModifyCol(1, 135)
    LV_ModifyCol(2, 160)
    LV_ModifyCol(3, 300)
    SB_SetText("INI " rowCount "개 항목 로드됨")
}

SaveIniValue(section, key, value)
{
    global INI_FILE

    section := Trim(section)
    key := Trim(key)
    if (section = "" || key = "") {
        MsgBox, 48, INI 저장, 섹션과 키를 입력해주세요.
        return
    }

    EnsureIniFile()
    IniWrite, %value%, %INI_FILE%, %section%, %key%
    LoadIniRows()
    GuiControl, , IniSectionEdit, %section%
    GuiControl, , IniKeyEdit, %key%
    GuiControl, , IniValueEdit, %value%
    SB_SetText("INI 저장: [" section "] " key)
}

DeleteIniValue(section, key)
{
    global INI_FILE

    section := Trim(section)
    key := Trim(key)
    if (section = "" || key = "") {
        MsgBox, 48, INI 삭제, 삭제할 섹션과 키를 선택해주세요.
        return
    }

    if !FileExist(INI_FILE) {
        MsgBox, 48, INI 삭제, INI 파일이 없습니다.
        return
    }

    IniDelete, %INI_FILE%, %section%, %key%
    GuiControl, , IniValueEdit,
    LoadIniRows()
    SB_SetText("INI 삭제: [" section "] " key)
}

EnsureIniFile()
{
