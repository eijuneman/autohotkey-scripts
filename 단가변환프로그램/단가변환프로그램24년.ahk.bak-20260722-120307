EnsureFile(filePath)
{
    SplitPath, filePath, , iniDir
    if (iniDir != "" && !FileExist(iniDir))
        FileCreateDir, %iniDir%

    if !FileExist(filePath)
        FileAppend, , %filePath%, UTF-8
}


